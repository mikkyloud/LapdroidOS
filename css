body {
  background: linear-gradient(to bottom right, #222, #752020);
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  transition: background 1s ease;
}

.phone-screen {
  width: 375px;
  height: 667px;
  border: 5px solid #000;
  border-radius: 40px;
  background: #f4f4f4;
  padding: 20px;
  box-shadow: 0 0 20px #000;
}

.app {
  margin: 15px;
  padding: 20px;
  background: gold;
  border-radius: 15px;
  font-size: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.app:hover {
  background: purple;
  color: white;
}

body.morphing {
  animation: flash 0.5s alternate infinite;
}

@keyframes flash {
  0% { background-color: red; }
  100% { background-color: black; }
}
